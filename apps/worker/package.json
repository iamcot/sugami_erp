{
  "name": "@sugami/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sugami/carriers-allingo": "workspace:*",
    "@sugami/channels-pancake": "workspace:*",
    "@sugami/db": "workspace:*",
    "@sugami/notify": "workspace:*",
    "@sugami/shared": "workspace:*",
    "@sugami/sync": "workspace:*",
    "bullmq": "^6.7.8",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "vitest": "^5.1.1"
  }
}
