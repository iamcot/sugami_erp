// Sugami ERP database schema (MySQL 8.4, utf8mb4_0900_ai_ci).
// Conventions: ids are UUIDv7 strings; money is integer VND (đồng) / CNY (fen);
// quantities are Decimal(14,3). Table names are snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Users & access control
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(uuid(7)) @db.Char(36)
  email            String     @unique @db.VarChar(191)
  name             String     @db.VarChar(191)
  passwordHash     String     @map("password_hash") @db.VarChar(255)
  isActive         Boolean    @default(true) @map("is_active")
  lastLoginAt      DateTime?  @map("last_login_at")
  /// Consecutive failed logins; reset on success.
  failedLoginCount Int        @default(0) @map("failed_login_count")
  /// Login refused until this time after too many failures.
  lockedUntil      DateTime?  @map("locked_until")
  sessions         Session[]
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  roles            UserRole[]
  auditLogs        AuditLog[]
  mediaUploads     MediaAsset[]

  @@map("users")
}

/// Login session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String   @id @db.Char(64)
  userId     String   @map("user_id") @db.Char(36)
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String     @id @default(uuid(7)) @db.Char(36)
  /// Stable code used in code/guards, e.g. "owner", "warehouse".
  code        String     @unique @db.VarChar(64)
  name        String     @db.VarChar(191)
  /// Permission codes, e.g. ["catalog.read", "inventory.write"]. "*" = everything.
  permissions Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Append-only log of sensitive changes (prices, stock, deletions, settings).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid(7)) @db.Char(36)
  parentId  String?    @map("parent_id") @db.Char(36)
  name      String     @db.VarChar(191)
  slug      String     @unique @db.VarChar(191)
  sort      Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Char(36)
  name      String    @unique @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("brands")
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id          String          @id @default(uuid(7)) @db.Char(36)
  /// Product code; variant SKUs are built from it (see buildSku in @sugami/shared).
  code        String          @unique @db.VarChar(64)
  name        String          @db.VarChar(255)
  /// Lowercase, diacritic-free name for search ("xe dieu khien").
  searchKey   String          @map("search_key") @db.VarChar(255)
  categoryId  String?         @map("category_id") @db.Char(36)
  brandId     String?         @map("brand_id") @db.Char(36)
  status      ProductStatus   @default(draft)
  description String?         @db.Text
  /// Toy attributes: { ageMin, material, battery, certification, dimensionsMm, ... }
  attributes  Json?
  unit        String          @default("cái") @db.VarChar(32)
  weightGrams Int?            @map("weight_grams")
  tags        Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  options     ProductOption[]
  variants    Variant[]
  media       ProductMedia[]

  @@index([searchKey])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductOption {
  id        String               @id @default(uuid(7)) @db.Char(36)
  productId String               @map("product_id") @db.Char(36)
  /// e.g. "Màu", "Kích thước"
  name      String               @db.VarChar(64)
  sort      Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String        @id @default(uuid(7)) @db.Char(36)
  optionId String        @map("option_id") @db.Char(36)
  value    String        @db.VarChar(64)
  sort     Int           @default(0)
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, value])
  @@map("product_option_values")
}

enum VariantStatus {
  active
  inactive
}

/// A sellable SKU. Stock, prices, orders and channel listings all hang off variants.
model Variant {
  id              String              @id @default(uuid(7)) @db.Char(36)
  productId       String              @map("product_id") @db.Char(36)
  /// SKU = KiotViet product code = seller SKU on Shopee/TikTok.
  sku             String              @unique @db.VarChar(64)
  barcode         String?             @unique @db.VarChar(64)
  /// Option values in option order, e.g. ["Đỏ", "Lớn"].
  optionValues    Json                @map("option_values")
  /// Retail price, VND.
  price           BigInt              @default(0)
  /// "Was" price shown crossed out, VND.
  compareAtPrice  BigInt?             @map("compare_at_price")
  /// Weighted average cost, VND. Maintained by inventory receipts only.
  costAvg         BigInt              @default(0) @map("cost_avg")
  weightGrams     Int?                @map("weight_grams")
  minStock        Decimal             @default(0) @map("min_stock") @db.Decimal(14, 3)
  reorderQty      Decimal?            @map("reorder_qty") @db.Decimal(14, 3)
  status          VariantStatus       @default(active)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitConversions UnitConversion[]
  comboItems      ComboItem[]         @relation("ComboParent")
  usedInCombos    ComboItem[]         @relation("ComboComponent")
  prices          PriceListItem[]
  stockLevels     StockLevel[]
  media           ProductMedia[]
  orderLines      OrderLine[]
  movements       StockMovement[]
  documentLines   StockDocumentLine[]

  @@index([productId])
  @@map("variants")
}

/// e.g. 1 "hộp" = 12 "cái".
model UnitConversion {
  id        String  @id @default(uuid(7)) @db.Char(36)
  variantId String  @map("variant_id") @db.Char(36)
  unit      String  @db.VarChar(32)
  factor    Decimal @db.Decimal(14, 3)
  barcode   String? @unique @db.VarChar(64)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, unit])
  @@map("unit_conversions")
}

model ComboItem {
  comboVariantId     String  @map("combo_variant_id") @db.Char(36)
  componentVariantId String  @map("component_variant_id") @db.Char(36)
  quantity           Decimal @db.Decimal(14, 3)
  combo              Variant @relation("ComboParent", fields: [comboVariantId], references: [id], onDelete: Cascade)
  component          Variant @relation("ComboComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@id([comboVariantId, componentVariantId])
  @@index([componentVariantId])
  @@map("combo_items")
}

model PriceList {
  id        String          @id @default(uuid(7)) @db.Char(36)
  name      String          @db.VarChar(191)
  /// Channel code this list applies to (shopee, tiktok, ...), null = general.
  channel   String?         @db.VarChar(32)
  createdAt DateTime        @default(now()) @map("created_at")
  items     PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  priceListId String    @map("price_list_id") @db.Char(36)
  variantId   String    @map("variant_id") @db.Char(36)
  price       BigInt
  validFrom   DateTime? @map("valid_from")
  validTo     DateTime? @map("valid_to")
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([priceListId, variantId])
  @@map("price_list_items")
}

/// Mapping from Sugami entities to external systems (KiotViet, Shopee, TikTok).
model ExternalRef {
  id           String   @id @default(uuid(7)) @db.Char(36)
  entityType   String   @map("entity_type") @db.VarChar(32)
  entityId     String   @map("entity_id") @db.Char(36)
  provider     String   @db.VarChar(32)
  externalId   String   @map("external_id") @db.VarChar(128)
  externalCode String?  @map("external_code") @db.VarChar(128)
  /// Hash of the last synced payload, to skip unchanged records.
  hash         String?  @db.VarChar(64)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([provider, entityType, externalId])
  @@index([entityType, entityId])
  @@map("external_refs")
}

// ---------------------------------------------------------------------------
// Inventory: stock_movements is the append-only ledger; stock_levels is the
// running total per warehouse+variant, updated in the same transaction.
// ---------------------------------------------------------------------------

enum WarehouseType {
  store
  warehouse
  virtual
}

model Warehouse {
  id                String          @id @default(uuid(7)) @db.Char(36)
  code              String          @unique @db.VarChar(32)
  name              String          @db.VarChar(191)
  type              WarehouseType   @default(warehouse)
  address           String?         @db.VarChar(255)
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  stockLevels       StockLevel[]
  movements         StockMovement[]
  documents         StockDocument[] @relation("DocumentWarehouse")
  orders            Order[]
  incomingTransfers StockDocument[] @relation("DocumentToWarehouse")

  @@map("warehouses")
}

model StockLevel {
  warehouseId    String    @map("warehouse_id") @db.Char(36)
  variantId      String    @map("variant_id") @db.Char(36)
  onHand         Decimal   @default(0) @map("on_hand") @db.Decimal(14, 3)
  /// Held for confirmed but not yet shipped orders.
  reserved       Decimal   @default(0) @db.Decimal(14, 3)
  /// Ordered from suppliers, not yet received.
  incoming       Decimal   @default(0) @db.Decimal(14, 3)
  /// Last movement id applied, for auditing.
  lastMovementId BigInt?   @map("last_movement_id")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant        Variant   @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([warehouseId, variantId])
  @@index([variantId])
  @@map("stock_levels")
}

enum MovementType {
  opening
  purchase_in
  sale_out
  return_in
  return_out
  transfer_in
  transfer_out
  adjust
  count
  damage
  kiotviet_import
}

model StockMovement {
  id           BigInt         @id @default(autoincrement())
  warehouseId  String         @map("warehouse_id") @db.Char(36)
  variantId    String         @map("variant_id") @db.Char(36)
  /// Signed quantity change.
  qtyDelta     Decimal        @map("qty_delta") @db.Decimal(14, 3)
  /// Unit cost in VND for inbound movements (used for average cost).
  unitCost     BigInt?        @map("unit_cost")
  /// on_hand after this movement (snapshot for the stock card).
  balanceAfter Decimal        @map("balance_after") @db.Decimal(14, 3)
  type         MovementType
  documentId   String?        @map("document_id") @db.Char(36)
  refType      String?        @map("ref_type") @db.VarChar(32)
  refId        String?        @map("ref_id") @db.VarChar(64)
  note         String?        @db.VarChar(255)
  occurredAt   DateTime       @default(now()) @map("occurred_at")
  createdBy    String?        @map("created_by") @db.Char(36)
  createdAt    DateTime       @default(now()) @map("created_at")
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant      Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  document     StockDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId, occurredAt])
  @@index([documentId])
  @@map("stock_movements")
}

enum StockDocumentType {
  receipt
  issue
  transfer
  adjustment
  count
}

enum StockDocumentStatus {
  draft
  confirmed
  cancelled
}

model StockDocument {
  id                   String              @id @default(uuid(7)) @db.Char(36)
  code                 String              @unique @db.VarChar(32)
  type                 StockDocumentType
  status               StockDocumentStatus @default(draft)
  warehouseId          String              @map("warehouse_id") @db.Char(36)
  toWarehouseId        String?             @map("to_warehouse_id") @db.Char(36)
  reason               String?             @db.VarChar(255)
  /// When this document was exported to KiotViet as an Excel import file.
  exportedToKiotvietAt DateTime?           @map("exported_to_kiotviet_at")
  confirmedAt          DateTime?           @map("confirmed_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  createdBy            String?             @map("created_by") @db.Char(36)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  warehouse            Warehouse           @relation("DocumentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  toWarehouse          Warehouse?          @relation("DocumentToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  lines                StockDocumentLine[]
  movements            StockMovement[]

  @@index([type, status])
  @@map("stock_documents")
}

model StockDocumentLine {
  id         String        @id @default(uuid(7)) @db.Char(36)
  documentId String        @map("document_id") @db.Char(36)
  variantId  String        @map("variant_id") @db.Char(36)
  /// Signed for adjustments; positive for receipts/issues/transfers (direction comes from type).
  quantity   Decimal       @db.Decimal(14, 3)
  unitCost   BigInt?       @map("unit_cost")
  note       String?       @db.VarChar(255)
  document   StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variant    Variant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("stock_document_lines")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  image
  video
  file
}

enum MediaStatus {
  /// Upload URL issued, file not confirmed in storage yet.
  pending
  ready
}

/// One uploaded file. The bytes live in storage (S3 / local) under storageKey.
model MediaAsset {
  id           String         @id @default(uuid(7)) @db.Char(36)
  kind         MediaKind
  status       MediaStatus    @default(pending)
  /// Full object key, prefix included (e.g. "sugami/media/2026/11/<id>.jpg").
  storageKey   String         @unique @map("storage_key") @db.VarChar(512)
  originalName String         @map("original_name") @db.VarChar(255)
  mime         String         @db.VarChar(127)
  sizeBytes    BigInt         @map("size_bytes")
  width        Int?
  height       Int?
  /// SHA-256 hex, for duplicate detection (filled by the image worker).
  checksum     String?        @db.Char(64)
  alt          String?        @db.VarChar(255)
  tags         Json?
  /// Where it came from: upload, kiotviet, shopee, taobao...
  source       String         @default("upload") @db.VarChar(32)
  uploadedBy   String?        @map("uploaded_by") @db.Char(36)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  uploader     User?          @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  variants     MediaVariant[]
  usages       ProductMedia[]

  @@index([status, createdAt])
  @@index([checksum])
  @@map("media_assets")
}

/// Derived file (thumbnail, 1:1 1000px, WebP...) made by the worker (P3-03).
model MediaVariant {
  id         String     @id @default(uuid(7)) @db.Char(36)
  assetId    String     @map("asset_id") @db.Char(36)
  preset     String     @db.VarChar(32)
  storageKey String     @unique @map("storage_key") @db.VarChar(512)
  width      Int?
  height     Int?
  sizeBytes  BigInt?    @map("size_bytes")
  createdAt  DateTime   @default(now()) @map("created_at")
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, preset])
  @@map("media_variants")
}

enum ProductMediaRole {
  main
  gallery
  size_chart
  video
}

/// Media attached to a product (optionally one variant, optionally one channel).
model ProductMedia {
  id          String           @id @default(uuid(7)) @db.Char(36)
  productId   String           @map("product_id") @db.Char(36)
  variantId   String?          @map("variant_id") @db.Char(36)
  assetId     String           @map("asset_id") @db.Char(36)
  role        ProductMediaRole @default(gallery)
  sort        Int              @default(0)
  /// null = all channels; otherwise "shopee", "tiktok"...
  channelCode String?          @map("channel_code") @db.VarChar(32)
  createdAt   DateTime         @default(now()) @map("created_at")
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     Variant?         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  asset       MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([productId, sort])
  @@index([assetId])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// Sales channels & orders
// ---------------------------------------------------------------------------

enum ChannelType {
  shopee
  tiktok
  lazada
  facebook
  zalo
  website
  store
}

model Channel {
  id             String      @id @default(uuid(7)) @db.Char(36)
  /// Stable code used in code and imports: "shopee", "tiktok", "store".
  code           String      @unique @db.VarChar(32)
  type           ChannelType
  name           String      @db.VarChar(191)
  /// Shop id on the marketplace, once connected.
  shopExternalId String?     @map("shop_external_id") @db.VarChar(64)
  isActive       Boolean     @default(true) @map("is_active")
  settings       Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  orders         Order[]

  @@map("channels")
}

/// Customer. Imports only store the KiotViet customer code: names, phones and addresses
/// in KiotViet exports are masked and are not copied.
model Customer {
  id           String   @id @default(uuid(7)) @db.Char(36)
  kiotvietCode String?  @unique @map("kiotviet_code") @db.VarChar(64)
  name         String?  @db.VarChar(191)
  phone        String?  @db.VarChar(32)
  email        String?  @db.VarChar(191)
  address      Json?
  tags         Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@map("customers")
}

enum OrderStatus {
  new
  confirmed
  packing
  shipped
  delivered
  completed
  cancelled
  returned
}

model Order {
  id                  String      @id @default(uuid(7)) @db.Char(36)
  /// Sugami order code; for KiotViet imports, the invoice code (HDSPE_..., HD000123).
  code                String      @unique @db.VarChar(64)
  channelId           String      @map("channel_id") @db.Char(36)
  /// Order number on the marketplace (Shopee order sn).
  externalCode        String?     @map("external_code") @db.VarChar(64)
  kiotvietInvoiceCode String?     @unique @map("kiotviet_invoice_code") @db.VarChar(64)
  kiotvietOrderCode   String?     @map("kiotviet_order_code") @db.VarChar(64)
  customerId          String?     @map("customer_id") @db.Char(36)
  warehouseId         String      @map("warehouse_id") @db.Char(36)
  status              OrderStatus @default(new)
  /// Raw delivery status text from the source (e.g. "Giao thành công").
  shippingStatus      String?     @map("shipping_status") @db.VarChar(64)
  carrier             String?     @db.VarChar(64)
  trackingNo          String?     @map("tracking_no") @db.VarChar(64)
  /// All amounts in VND.
  subtotal            BigInt      @default(0)
  discount            BigInt      @default(0)
  otherIncome         BigInt      @default(0) @map("other_income")
  total               BigInt      @default(0)
  paidAmount          BigInt      @default(0) @map("paid_amount")
  codAmount           BigInt      @default(0) @map("cod_amount")
  /// Fee paid to the carrier ("Phí trả ĐTGH").
  shippingFee         BigInt      @default(0) @map("shipping_fee")
  orderedAt           DateTime    @map("ordered_at")
  completedAt         DateTime?   @map("completed_at")
  /// kiotviet_excel, shopee_api, manual...
  source              String      @db.VarChar(32)
  /// Set when sale_out movements were written for this order (null = no stock effect).
  stockAppliedAt      DateTime?   @map("stock_applied_at")
  internalNote        String?     @map("internal_note") @db.VarChar(1000)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  channel             Channel     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouse           Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines               OrderLine[]

  @@index([channelId, orderedAt])
  @@index([orderedAt])
  @@index([status])
  @@index([externalCode])
  @@map("orders")
}

model OrderLine {
  id           String   @id @default(uuid(7)) @db.Char(36)
  orderId      String   @map("order_id") @db.Char(36)
  /// Null when the SKU is unknown in Sugami.
  variantId    String?  @map("variant_id") @db.Char(36)
  sku          String   @db.VarChar(64)
  name         String   @db.VarChar(255)
  qty          Decimal  @db.Decimal(14, 3)
  /// List price per unit before line discount, VND.
  unitPrice    BigInt   @map("unit_price")
  /// Discount per unit, VND.
  discount     BigInt   @default(0)
  /// Selling price per unit after discount, VND.
  price        BigInt
  lineTotal    BigInt   @map("line_total")
  /// Variant average cost when the line was recorded, VND (for margin).
  costSnapshot BigInt?  @map("cost_snapshot")
  sort         Int      @default(0)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_lines")
}

// ---------------------------------------------------------------------------
// Sync
// ---------------------------------------------------------------------------

/// Inbox for incoming webhooks: stored first, answered 200, processed later by the worker.
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Char(36)
  /// "pancake", "shopee", "tiktok".
  provider    String    @db.VarChar(32)
  eventType   String    @map("event_type") @db.VarChar(64)
  /// Provider delivery id, or a SHA-256 of the body when the provider sends none (dedupes retries).
  deliveryId  String    @map("delivery_id") @db.VarChar(128)
  body        Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text

  @@unique([provider, deliveryId])
  @@index([processedAt, receivedAt])
  @@map("webhook_events")
}
