{
  "name": "@sugami/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sugami/channels-core": "workspace:*",
    "@sugami/db": "workspace:*",
    "@sugami/shared": "workspace:*",
    "@sugami/carriers-allingo": "workspace:*"
  },
  "devDependencies": {
    "@sugami/channels-pancake": "workspace:*",
    "@types/node": "^22.20.5",
    "vitest": "^5.1.1"
  }
}
