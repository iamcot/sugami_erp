{
  "name": "sugami-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "node scripts/check-env.mjs",
    "infra:up": "node scripts/compose.mjs up -d",
    "infra:down": "node scripts/compose.mjs down",
    "infra:mysql": "node scripts/compose.mjs --profile mysql up -d",
    "db:generate": "pnpm --filter @sugami/db db:generate",
    "db:migrate": "pnpm --filter @sugami/db db:migrate",
    "db:deploy": "pnpm --filter @sugami/db db:deploy",
    "db:seed": "pnpm --filter @sugami/db db:seed",
    "db:studio": "pnpm --filter @sugami/db db:studio",
    "storage:check": "pnpm --filter @sugami/storage build && pnpm --filter @sugami/storage check",
    "pancake:probe": "pnpm --filter @sugami/channels-pancake build && pnpm --filter @sugami/channels-pancake probe",
    "allingo:probe": "pnpm --filter @sugami/channels-core build && pnpm --filter @sugami/carriers-allingo build && pnpm --filter @sugami/carriers-allingo probe",
    "vapid:generate": "pnpm --filter @sugami/notify build && pnpm --filter @sugami/notify vapid",
    "kiotviet:probe": "pnpm --filter @sugami/channels-kiotviet build && pnpm --filter @sugami/channels-kiotviet probe -- --out ../../../kiotviet-probe-report.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
