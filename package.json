{
  "name": "sugami-erp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:mysql": "docker compose --profile mysql up -d",
    "db:generate": "pnpm --filter @sugami/db db:generate",
    "db:migrate": "pnpm --filter @sugami/db db:migrate",
    "db:deploy": "pnpm --filter @sugami/db db:deploy",
    "db:seed": "pnpm --filter @sugami/db db:seed",
    "db:studio": "pnpm --filter @sugami/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
