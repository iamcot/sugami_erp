# Copy to .env and adjust. Never commit .env.

# --- Database (native MySQL 8.4 on the iMac) ---
# Apps running on the host use localhost. Containers use host.docker.internal instead.
DATABASE_URL=mysql://sugami:sugami-dev@localhost:3306/sugami
# Prisma shadow DB for `prisma migrate dev` (user needs CREATE/DROP on it)
SHADOW_DATABASE_URL=mysql://sugami:sugami-dev@localhost:3306/sugami_shadow

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- File storage (images, videos, attachments) ---
# local: files on disk under STORAGE_DIR (backed up nightly). s3: any S3-compatible store (e.g. Cloudflare R2).
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Apps ---
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Secrets ---
# 32-byte key (base64) used to encrypt channel credentials at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- KiotViet (P0-05, filled on the iMac only) ---
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=

# --- First owner account (used once by `pnpm db:seed`) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Chủ shop
