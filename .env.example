# Copy to .env and adjust. Never commit .env.

# --- Database (native MySQL 8.4 on the iMac) ---
# Apps running on the host use localhost. Containers use host.docker.internal instead.
DATABASE_URL=mysql://sugami:sugami-dev@localhost:3306/sugami
# Prisma shadow DB for `prisma migrate dev` (user needs CREATE/DROP on it)
SHADOW_DATABASE_URL=mysql://sugami:sugami-dev@localhost:3306/sugami_shadow

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- File storage (images, videos, attachments) ---
# s3 (default): the shop's existing AWS S3 bucket. local: files on disk under STORAGE_DIR (dev/offline,
# needs APP_ENCRYPTION_KEY to sign upload links). Test the setup with `pnpm storage:check`.
STORAGE_DRIVER=s3
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: only for S3-compatible providers (R2, ...). Leave empty for AWS.
S3_ENDPOINT=
# Optional: public base URL (CloudFront or bucket URL) used to build image links.
S3_PUBLIC_BASE_URL=
# Key prefix so Sugami files stay separate from other data in the bucket.
S3_PREFIX=sugami/
STORAGE_DIR=./data/storage

# --- Apps ---
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Secrets ---
# 32-byte key (base64) used to encrypt channel credentials at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- KiotViet Public API (only on the Cao cấp plan; not used currently) ---
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=

# --- Pancake POS Open API (trial; lớp trung gian tới Shopee/TikTok) ---
# API key: Pancake > Cài đặt > Ứng dụng > Webhook/API > API Key. Shop id: số trong URL của shop.
PANCAKE_API_KEY=
PANCAKE_SHOP_ID=
# Chuỗi ngẫu nhiên; nhập vào webhook_headers của Pancake với tên header x-sugami-secret.
PANCAKE_WEBHOOK_SECRET=
# Chat Shopee (menu Chat, chỉ đọc): Pancake > trang Shopee > Cài đặt > Công cụ > tạo page access token.
# Page id là mã trang trong Pancake (dạng spo_<số>). Token khác API key POS ở trên.
PANCAKE_CHAT_PAGE_ID=
PANCAKE_CHAT_TOKEN=

# --- Thông báo đẩy (PWA) ---
# Tạo một lần: pnpm vapid:generate
# Đổi cặp khóa này thì mọi điện thoại phải bật lại thông báo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://erp.sugami.vn

# --- First owner account (used once by `pnpm db:seed`) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Chủ shop

# --- Shopee Open Platform (P0-08, filled on the iMac only) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV=test

# --- TikTok Shop Partner (P0-08, filled on the iMac only) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Pancake warehouse that receives pushed products/stock (optional when the shop has only one warehouse).
PANCAKE_WAREHOUSE_ID=
# Pancake order sync in the worker: pulls Shopee VN / TikTok orders every 5 minutes (and on start).
# "off" disables it. Orders are deducted from the warehouse below.
PANCAKE_ORDER_SYNC=on
PANCAKE_SYNC_WAREHOUSE=KHO-CHINH

# Kho bán hàng của trang Bán hàng (mặc định KHO-CHINH)
POS_WAREHOUSE=KHO-CHINH
